# ================================================================
# 复制本文件为 .env，并填入真实值
# cp .env.example .env
# ================================================================

# 服务监听端口
PORT=3000

# Steam Web API Key（去 steamcommunity.com/dev/apikey 申请）
STEAM_API_KEY=在这里填入你的Key

# JWT 签名密钥（随便一长串随机字符，越乱越好）
JWT_SECRET=change_me_to_a_long_random_string

# 后端对外地址（必须是公网 HTTPS，Steam 回调用）
# 例：https://api.gosheng.top
BASE_URL=https://api.你的域名

# App 的 deep link scheme（用于登录成功后跳回 App）
# 例：goshen
APP_SCHEME=goshen
